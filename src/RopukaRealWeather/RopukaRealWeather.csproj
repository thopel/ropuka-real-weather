<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RopukaRealWeather</AssemblyName>
    <RootNamespace>RopukaRealWeather</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">$(ROPukaGameDir)</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ROPukaBepInExDir)</BepInExDir>
  </PropertyGroup>

  <Target Name="ValidateLocalDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="GameDir is required. Pass -p:GameDir=&quot;path to RopukaIdleIsland&quot;." />
    <Error Condition="'$(BepInExDir)' == ''" Text="BepInExDir is required. Pass -p:BepInExDir=&quot;path to extracted BepInEx&quot;." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)\RopukaIdleIsland_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameDir)\RopukaIdleIsland_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)\RopukaIdleIsland_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameDir)\RopukaIdleIsland_Data\Managed\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
</Project>

